APP_NAME=Agentic RAG Learning
APP_ENV=development

APP_API_KEY=replace_with_a_random_key_at_least_32_characters_long

RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]


OPENAI_API_KEY=replace_with_your_openai_key

POSTGRES_PASSWORD=replace_with_your_database_password

API_BASE_URL=http://127.0.0.1:8000


APP_NAME="Agentic RAG Learning"
APP_ENV=development

# Windows connections. Compose overrides these inside the backend.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=rag
POSTGRES_DB=rag_db
POSTGRES_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=rag_document_chunks

# Generate a random application key of at least 32 characters.
APP_API_KEY=

RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=["http://localhost:8502","http://127.0.0.1:8502"]

# Windows Streamlit connection. Compose overrides this for its frontend.
API_BASE_URL=http://127.0.0.1:8000